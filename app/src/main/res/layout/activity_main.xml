<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:filterTouchesWhenObscured="true"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_step"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/ScreenTitle"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/infoButton"
            style="@style/IconButton"
            android:contentDescription="@string/info"
            android:src="@drawable/ic_info" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/tabRequest"
            style="@style/TabButton"
            android:layout_marginEnd="4dp"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:text="@string/tab_request" />

        <Button
            android:id="@+id/tabResponse"
            style="@style/TabButton"
            android:layout_marginEnd="4dp"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:text="@string/tab_response" />

        <Button
            android:id="@+id/tabSaved"
            style="@style/TabButton"
            android:layout_marginEnd="4dp"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:text="@string/tab_saved" />

        <Button
            android:id="@+id/tabHistory"
            style="@style/TabButton"
            android:layout_marginEnd="4dp"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:text="@string/tab_history" />

        <Button
            android:id="@+id/tabEnv"
            style="@style/TabButton"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:text="@string/tab_env" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panelRequest"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/requestScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/methodButton"
                        style="@style/SecondaryButton"
                        android:layout_width="84dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="6dp"
                        android:minWidth="0dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:saveEnabled="false" />

                    <dev.nekuz.reqlab.SafeEditText
                        android:id="@+id/urlInput"
                        android:maxLength="1048576"
                        style="@style/Field"
                        android:importantForAutofill="no"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:hint="@string/url_hint"
                        android:inputType="textUri|textNoSuggestions"
                        android:maxLines="4"
                        android:scrollHorizontally="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_card"
                    android:padding="10dp"
                    android:textColor="@color/level_risk"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/environmentButton"
                    style="@style/SecondaryButton"
                    android:layout_height="38dp"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:saveEnabled="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="@string/section_params" />

                    <Button
                        android:id="@+id/addParam"
                        style="@style/SmallButton"
                        android:text="@string/add" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/paramsBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="@string/section_request_headers" />

                    <Button
                        android:id="@+id/addHeader"
                        style="@style/SmallButton"
                        android:text="@string/add" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/headersBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_marginTop="12dp"
                    android:layout_weight="0"
                    android:text="@string/section_auth" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/authNone"
                        style="@style/TabButton"
                        android:layout_height="38dp"
                        android:layout_marginEnd="4dp"
                        android:text="@string/auth_none" />

                    <Button
                        android:id="@+id/authBearer"
                        style="@style/TabButton"
                        android:layout_height="38dp"
                        android:layout_marginEnd="4dp"
                        android:text="@string/auth_bearer" />

                    <Button
                        android:id="@+id/authBasic"
                        style="@style/TabButton"
                        android:layout_height="38dp"
                        android:text="@string/auth_basic" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/bearerGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:visibility="gone">

                    <dev.nekuz.reqlab.SafeEditText
                        android:id="@+id/tokenInput"
                        android:maxLength="1048576"
                        style="@style/Field"
                        android:importantForAutofill="no"
                        android:hint="@string/token_hint"
                        android:inputType="textPassword|textNoSuggestions" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/basicGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <dev.nekuz.reqlab.SafeEditText
                        android:id="@+id/usernameInput"
                        android:maxLength="1048576"
                        style="@style/Field"
                        android:importantForAutofill="no"
                        android:hint="@string/username_hint"
                        android:inputType="textVisiblePassword|textNoSuggestions" />

                    <dev.nekuz.reqlab.SafeEditText
                        android:id="@+id/passwordInput"
                        android:maxLength="1048576"
                        style="@style/Field"
                        android:importantForAutofill="no"
                        android:layout_marginTop="6dp"
                        android:hint="@string/password_hint"
                        android:inputType="textPassword|textNoSuggestions" />
                </LinearLayout>

                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_marginTop="12dp"
                    android:layout_weight="0"
                    android:text="@string/section_request_body" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/bodyRaw"
                        style="@style/TabButton"
                        android:layout_height="38dp"
                        android:layout_marginEnd="4dp"
                        android:text="@string/body_raw" />

                    <Button
                        android:id="@+id/bodyJson"
                        style="@style/TabButton"
                        android:layout_height="38dp"
                        android:layout_marginEnd="4dp"
                        android:text="@string/body_type_json" />

                    <Button
                        android:id="@+id/bodyForm"
                        style="@style/TabButton"
                        android:layout_height="38dp"
                        android:text="@string/body_type_form" />
                </LinearLayout>

                <dev.nekuz.reqlab.SafeEditText
                    android:id="@+id/bodyInput"
                    style="@style/Field"
                    android:importantForAutofill="no"
                    android:layout_marginTop="6dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textVisiblePassword|textNoSuggestions"
                    android:maxLines="12"
                    android:minLines="4"
                    android:scrollbars="vertical" />

                <LinearLayout
                    android:id="@+id/formGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/formBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <Button
                        android:id="@+id/addField"
                        style="@style/SmallButton"
                        android:layout_marginTop="6dp"
                        android:text="@string/add" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/follow_redirects"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <Switch
                        android:id="@+id/followSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:filterTouchesWhenObscured="true"
                        android:saveEnabled="false"
                        android:thumbTint="@color/switch_thumb"
                        android:trackTint="@color/switch_track" />
                </LinearLayout>

                <Button
                    android:id="@+id/newButton"
                    style="@style/SecondaryButton"
                    android:layout_height="38dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/new_request" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">

            <Button
                android:id="@+id/sendButton"
                style="@style/TabButton"
                android:layout_marginEnd="4dp"
                android:layout_weight="1.6"
                android:background="@drawable/bg_button_primary"
                android:text="@string/send"
                android:textColor="@color/on_brand" />

            <Button
                android:id="@+id/previewButton"
                style="@style/TabButton"
                android:layout_marginEnd="4dp"
                android:text="@string/preview" />

            <Button
                android:id="@+id/saveButton"
                style="@style/TabButton"
                android:layout_marginEnd="4dp"
                android:text="@string/save" />

            <Button
                android:id="@+id/curlButton"
                style="@style/TabButton"
                android:text="@string/curl" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panelList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/actionsResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancelButton"
                style="@style/TabButton"
                android:layout_marginEnd="4dp"
                android:text="@string/cancel_request" />

            <Button
                android:id="@+id/copyBodyButton"
                style="@style/TabButton"
                android:layout_marginEnd="4dp"
                android:text="@string/copy_body" />

            <Button
                android:id="@+id/copyHeadersButton"
                style="@style/TabButton"
                android:text="@string/copy_headers" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/actionsHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <Button
                android:id="@+id/clearHistory"
                style="@style/SecondaryButton"
                android:text="@string/history_clear" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/actionsEnv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <Button
                android:id="@+id/newEnvironment"
                style="@style/SecondaryButton"
                android:text="@string/environment_new" />
        </FrameLayout>

        <ProgressBar
            android:id="@+id/bar"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/brand_soft"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="4dp"
                android:listSelector="@android:color/transparent"
                android:paddingBottom="16dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="24dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
